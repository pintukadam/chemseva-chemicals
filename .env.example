# ==============================================================================
# ChemSeva Chemicals - Zero-Cost Enquiry Backend Environment Variables
# ==============================================================================
# Copy this file to `.env.local` for local testing (never commit `.env.local`).
# On Vercel / Cloudflare Pages, add the same keys under Project Environment Variables.
#
# NOTE: Vite exposes variables prefixed with `VITE_` to the browser bundle.
# Never place private server-side secrets (like a Resend API key) in `VITE_*`.
# ==============================================================================

# Option A (Recommended - $0 Free): Web3Forms Access Key
# Get your free key at https://web3forms.com — emails go directly to your inbox.
VITE_WEB3FORMS_ACCESS_KEY=

# Option B (Alternative - $0 Free): Custom Form Endpoint
# Use this for Formspree (https://formspree.io/f/YOUR_FORM_ID),
# or a Vercel Serverless Function (/api/enquiry) backed by Resend.
# If VITE_WEB3FORMS_ACCESS_KEY is set, Web3Forms takes precedence.
VITE_FORM_ENDPOINT=

# Option C (Optional - $0 Free CRM): Google Apps Script Web App URL
# Automatically logs every valid enquiry into a Google Sheet in the background.
# See docs/google-apps-script.gs for the Apps Script setup template.
VITE_GOOGLE_SHEETS_WEBHOOK_URL=
